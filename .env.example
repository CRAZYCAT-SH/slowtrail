# 默认数据源配置（仅用于首次启动时自动创建一条默认数据源，之后以数据库中的配置为准）
# 如不需要自动创建默认数据源，可将以下配置留空

# 数据源类型：kibana_proxy | direct_es
ES_TYPE=kibana_proxy

# Kibana/ES 地址
ES_HOST=http://localhost:5601

# 认证信息
ES_USERNAME=
ES_PASSWORD=

# Kibana 代理路径（仅 kibana_proxy 类型使用）
ES_PROXY_PATH=/api/console/proxy

# 索引命名模板（占位符: {YYYY} {YY} {MM} {M} {DD} {D}，可含 *）
# 示例：
#   按日切分: mysql_slow_log-{YYYY}.{MM}.{DD}
#   按月切分: logs-{YYYY}-{MM}
#   不切分:   mysql_slow_log
#   纯通配:   mysql_slow_log-*
ES_INDEX_PATTERN=mysql_slow_log-{YYYY}.{MM}.{DD}

# 后端服务端口
PORT=3000
